{
	"name": "companion-module-hdr-status",
	"version": "0.1.0",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"format": "prettier -w .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && run build:main",
		"build:main": "tsc -p tsconfig.build.json",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint:raw": "eslint",
		"lint": "run lint:raw ."
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/yourname/companion-module-hdr-status.git"
	},
	"engines": {
		"node": "^26",
		"yarn": "^4"
	},
	"dependencies": {
		"@companion-module/base": "~2.1.3"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.1.1",
		"@types/node": "^26.6.4",
		"eslint": "^10.12.0",
		"prettier": "^3.9.9",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.0"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"packageManager": "yarn@4.18.1"
}